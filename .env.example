# Configuració de Firebase per a Som Llar Justificacions
# Afegeix aquestes variables a Vercel a Project Settings > Environment Variables

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=somllar-justificacions.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=somllar-justificacions
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=somllar-justificacions.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# Domini corporatiu autoritzat
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=somllar.cat
